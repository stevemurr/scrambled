"""EnCodec neural reconstruction module.

This module provides neural audio reconstruction using Meta's EnCodec codec.
EnCodec encodes audio to compressed tokens and decodes them back, learning
smooth transitions and high-quality reconstruction through its neural architecture.

Unlike simple concatenation, EnCodec reconstruction:
- Learns smooth transitions (no clicks or pops)
- Preserves audio quality through neural encoding
- Enables future token-space manipulation (blending, morphing)
"""

import numpy as np
import torch
from loguru import logger
from typing import List, Literal, Optional

from ..segmentation.audio_segment import AudioSegment
from .base import ReconstructionModule


class EnCodecReconstruction(ReconstructionModule):
    """Neural reconstruction using Meta's EnCodec codec.

    EnCodec (Enhanced Neural Codec) is a neural audio codec that compresses
    audio into discrete tokens and reconstructs it with high fidelity. The
    learned encoder/decoder provides smooth, artifact-free reconstruction.

    This implementation uses the on-the-fly approach: segments are encoded
    to tokens during reconstruction (not pre-computed). Future versions may
    store tokens in the database for faster reconstruction.

    Attributes:
        bandwidth: Compression bandwidth in kbps (3, 6, 12, or 24)
        device: Computation device ('cpu', 'cuda', or 'mps')
        model_name: HuggingFace model identifier
        blend_mode: Token blending strategy ('none' for now; future: 'overlap', 'interpolate')
        normalize: Whether to normalize output to [-1, 1]

    Examples:
        >>> # Basic usage with default settings
        >>> reconstructor = EnCodecReconstruction(bandwidth=6.0)
        >>> output = reconstructor.reconstruct(segments)

        >>> # High quality reconstruction
        >>> reconstructor = EnCodecReconstruction(bandwidth=24.0, device='cuda')
        >>> output = reconstructor.reconstruct(segments)
    """

    VALID_BANDWIDTHS = [3.0, 6.0, 12.0, 24.0]
    VALID_BLEND_MODES = ['none']  # Future: 'overlap', 'interpolate'
    EXPECTED_SAMPLE_RATE = 48000

    def __init__(
        self,
        bandwidth: float = 6.0,
        device: str = "cpu",
        model_name: str = "facebook/encodec_48khz",
        blend_mode: Literal["none"] = "none",
        normalize: bool = True
    ):
        """Initialize EnCodec reconstruction module.

        Args:
            bandwidth: Compression bandwidth in kbps. Higher = better quality but slower.
                      Valid values: 3.0, 6.0, 12.0, 24.0
                      - 3 kbps: Lowest quality, fastest
                      - 6 kbps: Good balance (default)
                      - 12 kbps: High quality
                      - 24 kbps: Highest quality, slowest
            device: Computation device. Options:
                   - 'cpu': Use CPU (always available)
                   - 'cuda': Use NVIDIA GPU (requires CUDA)
                   - 'mps': Use Apple Silicon GPU (macOS only)
            model_name: HuggingFace model identifier. Default is the 48kHz stereo model.
            blend_mode: Token blending strategy. Currently only 'none' is implemented.
                       Future versions will add 'overlap' and 'interpolate'.
            normalize: If True, normalize output to [-1, 1] to prevent clipping.

        Raises:
            ValueError: If bandwidth or blend_mode is invalid
            RuntimeError: If model fails to load
        """
        # Validate bandwidth
        if bandwidth not in self.VALID_BANDWIDTHS:
            raise ValueError(
                f"bandwidth must be one of {self.VALID_BANDWIDTHS}, got {bandwidth}"
            )

        # Validate blend mode
        if blend_mode not in self.VALID_BLEND_MODES:
            raise ValueError(
                f"blend_mode must be one of {self.VALID_BLEND_MODES}, got '{blend_mode}'"
            )

        self.bandwidth = bandwidth
        self.device = device
        self.model_name = model_name
        self.blend_mode = blend_mode
        self.normalize = normalize

        # Load EnCodec model
        logger.info(f"Loading EnCodec model '{model_name}' on device '{device}'...")
        try:
            from audiocraft.models import CompressionModel
            self.model = CompressionModel.get_pretrained(model_name)
            # Note: HuggingFace EnCodec model uses fixed bandwidth from config
            # The bandwidth parameter is stored for reference but not actively used

            # Move model to device
            if device != "cpu":
                self.model = self.model.to(device)

            logger.info(
                f"EnCodec loaded successfully (bandwidth={bandwidth}kbps, "
                f"device={device}, blend_mode={blend_mode})"
            )
        except Exception as e:
            logger.error(f"Failed to load EnCodec model: {e}")
            raise RuntimeError(
                f"Failed to load EnCodec model '{model_name}'. "
                f"Ensure audiocraft is installed: pip install audiocraft"
            ) from e

    def reconstruct(self, segments: List[AudioSegment]) -> np.ndarray:
        """Reconstruct audio from segments using EnCodec encode-decode.

        Process:
        1. Validate segments (sample rate, non-empty)
        2. Concatenate segment audio arrays
        3. Convert to stereo if mono (EnCodec 48khz model expects stereo)
        4. Encode audio to EnCodec tokens
        5. Decode tokens back to audio waveform
        6. Convert back to original format (mono/stereo)
        7. Normalize if requested

        Args:
            segments: List of AudioSegment objects. All must have same sample rate.
                     Expected sample rate is 48kHz for best results.

        Returns:
            Reconstructed audio as numpy array. Shape matches input segments.
            - If segments are mono: returns 1D array (samples,)
            - If segments are stereo: returns 2D array (2, samples)

        Raises:
            ValueError: If segments list is empty, sample rates don't match,
                       or sample rate is not 48kHz
        """
        # Validate input
        self.validate_segments(segments)

        # Get sample rate and check if it's 48kHz
        sr = segments[0].sr
        if sr != self.EXPECTED_SAMPLE_RATE:
            raise ValueError(
                f"EnCodec 48khz model expects {self.EXPECTED_SAMPLE_RATE}Hz audio, "
                f"but got {sr}Hz. Please resample your audio to 48kHz."
            )

        # Handle single segment case
        if len(segments) == 1:
            logger.debug("Single segment, encoding and decoding")
            audio = segments[0].audio.copy()
            audio = self._encode_decode(audio, sr)
            if self.normalize:
                audio = self._normalize_audio(audio)
            return audio

        # Concatenate all segments
        logger.debug(f"Concatenating {len(segments)} segments for EnCodec reconstruction")
        # For stereo: concatenate along time axis (axis=1), for mono: axis=0
        first_audio = segments[0].audio
        if first_audio.ndim == 2:
            # Stereo: (channels, samples) - concatenate along axis 1 (time)
            audio = np.concatenate([seg.audio for seg in segments], axis=1)
        else:
            # Mono: (samples,) - concatenate along axis 0
            audio = np.concatenate([seg.audio for seg in segments], axis=0)

        # Encode and decode through EnCodec
        audio = self._encode_decode(audio, sr)

        # Normalize if requested
        if self.normalize:
            audio = self._normalize_audio(audio)

        logger.info(
            f"EnCodec reconstructed {len(segments)} segments → "
            f"{audio.shape[-1]} samples ({audio.shape[-1]/sr:.2f}s) "
            f"at {self.bandwidth}kbps"
        )

        return audio

    def _encode_decode(self, audio: np.ndarray, sr: int) -> np.ndarray:
        """Encode audio to EnCodec tokens and decode back to waveform.

        Args:
            audio: Input audio array. Can be mono (samples,) or stereo (2, samples)
            sr: Sample rate in Hz

        Returns:
            Reconstructed audio in same format as input
        """
        # Determine if input is mono or stereo
        is_mono = audio.ndim == 1
        original_shape = audio.shape

        # Convert to stereo if mono (EnCodec 48khz expects stereo)
        if is_mono:
            audio = self._mono_to_stereo(audio)

        # Convert to tensor: (batch, channels, samples)
        audio_tensor = self._to_tensor(audio)

        # Encode to tokens
        logger.debug(f"Encoding audio: shape={audio_tensor.shape}")
        with torch.no_grad():
            encoded_frames = self.model.encode(audio_tensor)

        # Extract codes (discard scale for now)
        if isinstance(encoded_frames, tuple):
            codes, scale = encoded_frames
            logger.debug(
                f"Encoded to tokens: codes shape={codes.shape}, scale shape={scale.shape}"
            )
        else:
            codes = encoded_frames
            logger.debug(f"Encoded to tokens: shape={codes.shape}")

        # Decode tokens back to audio
        logger.debug("Decoding tokens back to audio")
        with torch.no_grad():
            decoded_tensor = self.model.decode(codes)

        # Convert back to numpy
        decoded_audio = self._from_tensor(decoded_tensor)

        # Convert back to mono if input was mono
        if is_mono:
            decoded_audio = self._stereo_to_mono(decoded_audio)

        # Handle length mismatch (EnCodec may return slightly different length)
        decoded_audio = self._match_length(decoded_audio, original_shape)

        return decoded_audio

    def _to_tensor(self, audio: np.ndarray) -> torch.Tensor:
        """Convert numpy audio to PyTorch tensor.

        Args:
            audio: Numpy array, shape (channels, samples) or (samples,)

        Returns:
            PyTorch tensor, shape (batch=1, channels, samples)
        """
        tensor = torch.from_numpy(audio).float()

        # Ensure shape is (channels, samples)
        if tensor.ndim == 1:
            tensor = tensor.unsqueeze(0)  # (samples,) -> (1, samples)

        # Add batch dimension: (channels, samples) -> (1, channels, samples)
        tensor = tensor.unsqueeze(0)

        # Move to device
        tensor = tensor.to(self.device)

        return tensor

    def _from_tensor(self, tensor: torch.Tensor) -> np.ndarray:
        """Convert PyTorch tensor to numpy audio.

        Args:
            tensor: PyTorch tensor, shape (batch, channels, samples)

        Returns:
            Numpy array, shape (channels, samples)
        """
        # Move to CPU and convert to numpy
        audio = tensor.cpu().numpy()

        # Remove batch dimension: (1, channels, samples) -> (channels, samples)
        audio = audio.squeeze(0)

        return audio

    def _mono_to_stereo(self, audio: np.ndarray) -> np.ndarray:
        """Convert mono audio to stereo by duplicating the channel.

        Args:
            audio: Mono audio, shape (samples,)

        Returns:
            Stereo audio, shape (2, samples)
        """
        return np.stack([audio, audio], axis=0)

    def _stereo_to_mono(self, audio: np.ndarray) -> np.ndarray:
        """Convert stereo audio to mono by averaging channels.

        Args:
            audio: Stereo audio, shape (2, samples)

        Returns:
            Mono audio, shape (samples,)
        """
        return np.mean(audio, axis=0)

    def _match_length(self, audio: np.ndarray, target_shape: tuple) -> np.ndarray:
        """Match audio length to target shape by trimming or padding.

        EnCodec may return slightly different lengths due to internal padding.
        This ensures the output matches the expected length.

        Args:
            audio: Reconstructed audio
            target_shape: Original audio shape

        Returns:
            Audio with length matching target_shape
        """
        # Determine target length based on shape
        if len(target_shape) == 1:
            # Mono: target_shape = (samples,)
            target_length = target_shape[0]
            current_length = audio.shape[0]
        else:
            # Stereo: target_shape = (2, samples)
            target_length = target_shape[1]
            current_length = audio.shape[1]

        if current_length == target_length:
            return audio
        elif current_length > target_length:
            # Trim
            logger.debug(
                f"Trimming audio from {current_length} to {target_length} samples"
            )
            if audio.ndim == 1:
                return audio[:target_length]
            else:
                return audio[:, :target_length]
        else:
            # Pad with zeros
            logger.debug(
                f"Padding audio from {current_length} to {target_length} samples"
            )
            pad_length = target_length - current_length
            if audio.ndim == 1:
                padding = np.zeros(pad_length, dtype=audio.dtype)
                return np.concatenate([audio, padding])
            else:
                padding = np.zeros((audio.shape[0], pad_length), dtype=audio.dtype)
                return np.concatenate([audio, padding], axis=1)

    def _normalize_audio(self, audio: np.ndarray) -> np.ndarray:
    def _pad_to_chunk_length(self, audio: np.ndarray, chunk_length: int) -> np.ndarray:
        """Pad audio to multiple of chunk length.
        
        HuggingFace EnCodec requires audio length to be a multiple of chunk_length
        (1 second = 48000 samples for 48kHz audio).
        
        Args:
            audio: Audio array, shape (channels, samples) or (samples,)
            chunk_length: Required chunk length in samples (typically 48000)
        
        Returns:
            Padded audio array
        """
        # Get current length
        if audio.ndim == 1:
            current_length = audio.shape[0]
        else:
            current_length = audio.shape[1]
        
        # Calculate padding needed
        remainder = current_length % chunk_length
        if remainder == 0:
            return audio  # Already properly padded
        
        pad_length = chunk_length - remainder
        logger.debug(
            f"Padding audio from {current_length} to {current_length + pad_length} samples "
            f"(chunk_length={chunk_length})"
        )
        
        # Pad with zeros
        if audio.ndim == 1:
            # Mono
            padding = np.zeros(pad_length, dtype=audio.dtype)
            return np.concatenate([audio, padding])
        else:
            # Stereo
            padding = np.zeros((audio.shape[0], pad_length), dtype=audio.dtype)
            return np.concatenate([audio, padding], axis=1)

        """Normalize audio to [-1, 1] range.

        Args:
            audio: Input audio array

        Returns:
            Normalized audio array
        """
        max_abs = np.abs(audio).max()
        if max_abs > 0:
            audio = audio / max_abs
            logger.debug(f"Normalized audio (max_abs={max_abs:.4f})")
        return audio

    def __repr__(self) -> str:
        return (
            f"EnCodecReconstruction("
            f"bandwidth={self.bandwidth}kbps, "
            f"device={self.device}, "
            f"blend_mode={self.blend_mode}, "
            f"normalize={self.normalize})"
        )
